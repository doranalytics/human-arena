# Required for real answers. Without it the app runs in demo mode (canned replies).
ANTHROPIC_API_KEY=

# Optional. Without these the app runs in guest mode: progress and chats stay in the browser,
# the leaderboard shows the seeded board plus you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public URL used in magic-link redirects. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=

# Optional: recognize paid Substack subscribers from the existing AI Certified import.
SUBSTACK_MEMBERS_SUPABASE_URL=
SUBSTACK_MEMBERS_SERVICE_ROLE_KEY=

# Circle Admin API v2, server-only. Inspect the token's community before setting its ID.
CIRCLE_API_TOKEN=
CIRCLE_COMMUNITY_ID=
# Protects /api/internal/circle-sync (also used by the daily Vercel cron).
CRON_SECRET=
