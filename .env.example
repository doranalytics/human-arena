# Required for real answers. Without it the app runs in demo mode (canned replies).
ANTHROPIC_API_KEY=

# Optional. Without these the app runs in guest mode: progress and chats stay in the browser,
# the leaderboard shows the seeded board plus you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public URL used in magic-link redirects. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=
